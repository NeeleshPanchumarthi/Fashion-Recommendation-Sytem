# Copy to .env and fill in real values. Never commit .env.

# --- Required ---------------------------------------------------------------
PINECONE_API_KEY=your-pinecone-api-key

# --- Optional (defaults shown) -----------------------------------------------
# Groq LLM for query understanding. Without a key, search uses regex-only
# query understanding.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Virtual try-on via a Hugging Face Space. A "Read" token from
# huggingface.co/settings/tokens raises the free GPU quota.
HF_TOKEN=
TRYON_SPACE=franciszzj/Leffa
TRYON_TIMEOUT_SECONDS=180
TRYON_MAX_ACTIVE_JOBS=4

PINECONE_INDEX=fashionvectors
PINECONE_REGION=us-east-1

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SENTIMENT_MODEL=nlptown/bert-base-multilingual-uncased-sentiment

TOP_K=36
DENSE_SEARCH_K=60
OUTFIT_DENSE_K=10
RERANK_CANDIDATES_K=48

LOG_LEVEL=INFO
# Regex of browser origins allowed by CORS.
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:\d+)?

# Ingestion worker (defaults are under the project's data/ folder)
# METADATA_PATH=data/metadata.parquet
# REVIEWS_PATH=data/reviews.parquet
BATCH_SIZE=15000
# CHECKPOINT_PATH=data/checkpoints/ingestion_state.json
# FAILURE_LOG_PATH=data/checkpoints/ingestion_failures.log
DUCKDB_MEMORY_LIMIT=2GB
