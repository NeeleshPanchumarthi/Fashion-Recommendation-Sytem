
flowchart LR
  subgraph CL["Client"]
    UI["React + Vite SPA<br/>search, filters, try-on dialog"]
  end

  subgraph API["API process: uvicorn app.main:app"]
    MW["Middleware<br/>CORS, X-Request-ID, error handler"]
    RT["Routers /api<br/>health, ready, search, try-on"]
    HS["HealthService"]
    SS["SearchService"]
    TS["TryOnService<br/>photo prep, in-memory jobs, thread pool"]

    subgraph RP["Retrieval pipeline"]
      QP["QueryProcessor<br/>regex first, LLM fills gaps"]
      EMB["EmbeddingClient<br/>SentenceTransformer, local"]
      RET["Retriever<br/>gender pools, outfit groups,<br/>filter relaxation"]
      RR["Reranker + RerankerClient<br/>cross-encoder, local"]
    end

    VR["VectorRepository<br/>Pinecone schema + filters"]
    PCL["PineconeClient"]
    LLMC["LLMClient"]
    TCL["TryOnClient<br/>Gradio API"]
  end

  subgraph WK["Ingestion worker: python -m workers.ingestion_worker (offline, resumable)"]
    DR["DatasetRepository<br/>DuckDB"]
    BP["BatchProcessor"]
    RA["ReviewAnalysisService<br/>SentimentClient, local BERT"]
    EN["Product enrichment<br/>attribute extractors, combined text"]
    EMB2["EmbeddingClient"]
    VR2["VectorRepository<br/>upsert with retry"]
    CK["CheckpointManager<br/>state + failure log"]
  end

  DS[("metadata.parquet<br/>reviews.parquet")]
  PC[("Pinecone index")]
  GQ["Groq LLM"]
  HF["Hugging Face Space<br/>Leffa try-on"]

